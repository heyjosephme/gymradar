---
import type { Badge } from '../lib/present.ts';

interface Props {
	badge: Badge;
}

const { badge } = Astro.props;
---

<span class:list={['badge', badge.tone]}><span class="icon" aria-hidden="true">{badge.icon}</span>{badge.label}</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.1em 0.6em 0.1em 0.2em;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-weight: 600;
		white-space: nowrap;
	}

	.icon {
		display: inline-grid;
		place-items: center;
		width: 1.4em;
		height: 1.4em;
		border-radius: 50%;
		background: var(--text-muted);
		color: #ffffff;
		font-size: 0.8em;
	}

	.good .icon {
		background: var(--good);
	}

	.warning .icon {
		background: var(--warning);
		color: #0b0b0b;
	}

	.critical .icon {
		background: var(--critical);
	}
</style>
