---
import { OCCUPANCY_LABEL } from '../lib/present.ts';
import type { GymOccupancy } from '../lib/types.ts';

interface Props {
	occupancy: GymOccupancy;
}

const { occupancy } = Astro.props;
const level = occupancy.officialLevel;
---

<span class="occupancy">
	{
		level !== null && (
			// Mirrors Konami's pictogram: N of 3 segments filled. One hue, because crowding is
			// context, not a verdict; the label and the segment count carry the meaning.
			<span class:list={['meter', { stale: occupancy.stale }]} aria-hidden="true">
				{[1, 2, 3].map((segment) => (
					<span class:list={['segment', { filled: segment <= level }]} />
				))}
			</span>
		)
	}
	<span class="label">
		{OCCUPANCY_LABEL[occupancy.status]}
		{level !== null && <span class="level">{` · official level ${level} of 3`}</span>}
	</span>
	{occupancy.stale && <strong class="stale-flag">⚠ Stale</strong>}
</span>

<style>
	.occupancy {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
	}

	.meter {
		display: inline-flex;
		gap: 2px;
	}

	.segment {
		width: 1.1em;
		height: 0.6em;
		border-radius: 2px;
		background: var(--meter-track);
	}

	.segment.filled {
		background: var(--meter-fill);
	}

	.meter.stale .segment {
		background: var(--hairline);
	}

	.meter.stale .segment.filled {
		background: var(--text-muted);
	}

	.label {
		font-weight: 600;
	}

	.level {
		font-weight: 400;
		color: var(--text-secondary);
	}

	.stale-flag {
		color: var(--text-primary);
	}
</style>
