---
// Rendered on every request: availability and occupancy must be current.
export const prerender = false;

import { Dashboard } from '@/components/dashboard/Dashboard';
import { defaultWorkout, favoriteGyms } from '@/config/gyms';
import Layout from '@/layouts/Layout.astro';
import { loadDashboard, planFromQuery } from '@/lib/dashboard';
import { japaneseHolidayName } from '@/lib/holidays';
import { formatClock, toJst } from '@/lib/time';

const now = new Date();
const jst = toJst(now);
const plan = planFromQuery(Astro.url.searchParams, defaultWorkout, jst.minutes);
const { evaluations, recommendation } = await loadDashboard(favoriteGyms, plan, now);

// Formatted here so the browser, whatever its time zone, hydrates the same text.
const dateLabel = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Tokyo', weekday: 'short', day: 'numeric', month: 'short' }).format(now);
const leaving = plan.departMinutes === jst.minutes ? 'leave now' : `leave at ${formatClock(plan.departMinutes)}`;

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="GymRadar">
	<Dashboard
		client:load
		nowIso={now.toISOString()}
		clock={formatClock(jst.minutes)}
		dateLabel={dateLabel}
		holiday={japaneseHolidayName(jst.date) ?? null}
		plan={plan}
		departValue={Astro.url.searchParams.get('depart') ?? ''}
		leaving={leaving}
		evaluations={evaluations}
		primaryId={recommendation.primary?.gym.id ?? null}
		explanation={recommendation.explanation}
	/>
</Layout>
